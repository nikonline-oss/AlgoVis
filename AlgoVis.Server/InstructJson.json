{
  "name": "BubbleSort",
  "description": "Сортировка пузырьком - алгоритм сортировки, который последовательно сравнивает соседние элементы массива и меняет их местами, если они находятся в неправильном порядке.",
  "structureType": "array",
  "variables": [
    {
      "name": "n",
      "type": "int",
      "initialValue": 0
    },
    {
      "name": "i",
      "type": "int",
      "initialValue": 0
    },
    {
      "name": "j",
      "type": "int",
      "initialValue": 0
    },
    {
      "name": "arr",
      "type": "array",
      "initialValue": "[]"
    }
  ],
  "functions": [
    {
      "name": "bubble_sort",
      "description": "Основная функция сортировки пузырьком",
      "parameters": [],
      "entryPoint": "init_n",
      "steps": [
        {
          "id": "init_n",
          "type": "assign",
          "description": "Инициализация переменной n",
          "parameters": [ "n", "struct.len" ],
          "nextStep": "init_i",
          "visualize": false
        },
        {
          "id": "init_i",
          "type": "assign",
          "description": "Инициализация внешнего цикла",
          "parameters": [ "i", "0" ],
          "nextStep": "outer_loop_check",
          "visualize": false
        },
        {
          "id": "outer_loop_check",
          "type": "condition",
          "description": "Проверка границ внешнего цикла",
          "parameters": [ "i < n" ],
          "conditionCases": [
            {
              "condition": "true",
              "nextStep": "init_j"
            },
            {
              "condition": "false",
              "nextStep": "return_from_function"
            }
          ],
          "visualize": true
        },
        {
          "id": "init_j",
          "type": "assign",
          "description": "Инициализация внутреннего цикла",
          "parameters": [ "j", "0" ],
          "nextStep": "inner_loop_check",
          "visualize": false
        },
        {
          "id": "inner_loop_check",
          "type": "condition",
          "description": "Проверка границ внутреннего цикла",
          "parameters": [ "j < n - i - 1" ],
          "conditionCases": [
            {
              "condition": "true",
              "nextStep": "compare_elements"
            },
            {
              "condition": "false",
              "nextStep": "increment_i"
            }
          ],
          "visualize": true
        },
        {
          "id": "compare_elements",
          "type": "compare",
          "description": "Сравнение соседних элементов",
          "parameters": [ "j", "j + 1" ],
          "nextStep": "check_swap",
          "visualize": true
        },
        {
          "id": "check_swap",
          "type": "condition",
          "description": "Проверка необходимости обмена",
          "parameters": [ "struct[j] > struct[j + 1]" ],
          "conditionCases": [
            {
              "condition": "true",
              "nextStep": "perform_swap"
            },
            {
              "condition": "false",
              "nextStep": "increment_j"
            }
          ],
          "visualize": true
        },
        {
          "id": "perform_swap",
          "type": "swap",
          "description": "Обмен элементов местами",
          "parameters": [ "j", "j + 1" ],
          "nextStep": "increment_j",
          "visualize": true
        },
        {
          "id": "increment_j",
          "type": "assign",
          "description": "Увеличение счётчика внутреннего цикла",
          "parameters": [ "j", "j + 1" ],
          "nextStep": "inner_loop_check",
          "visualize": false
        },
        {
          "id": "increment_i",
          "type": "assign",
          "description": "Увеличение счётчика внешнего цикла",
          "parameters": [ "i", "i + 1" ],
          "nextStep": "outer_loop_check",
          "visualize": false
        },
        {
          "id": "return_from_function",
          "type": "return",
          "description": "Возврат из функции сортировки",
          "nextStep": "end",
          "visualize": false
        }
      ]
    }
  ],
  "steps": [
    {
      "id": "start",
      "type": "call_function",
      "functionName": "bubble_sort",
      "functionParameters": {},
      "returnToStep": "end",
      "description": "Вызов функции сортировки пузырьком",
      "visualize": true
    },
    {
      "id": "end",
      "type": "generic",
      "description": "Сортировка завершена",
      "parameters": [],
      "visualize": true
    }
  ]
}